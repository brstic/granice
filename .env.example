# Kopiraj u .env i popuni. Ništa od ovoga ne ide u git.
PORT=3090
# HOST=127.0.0.1           # adresa na kojoj sajt sluša (iza nginx-a ostavi 127.0.0.1; Docker postavlja 0.0.0.0 sam)
NODE_ENV=production
# COOKIE_SECURE=0          # admin kolačić bez Secure – samo za http bez TLS-a (lokalno); u produkciji iza HTTPS-a ne dirati

# jedini administrator (/admin)
ADMIN_KORISNIK=admin
ADMIN_LOZINKA=
# potpis sesije: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# planer puta (OSRM, opciono – bez njega planer javlja grešku, ostatak sajta radi)
# OSRM_URL=http://127.0.0.1:5055

# radnik kamera (server/kamere.js) – najzahtevniji deo; na slabijoj mašini smanji
# KAMERE_INTERVAL_MIN=5         # krug na svakih N minuta
# KAMERE_PARALELNO=21           # kamera odjednom (laptop: 2–4)
# KAMERE_NITI=                  # niti po modelu (podrazumevano broj jezgara/6, 2–8)
# KAMERE_MODEL=yolov10x         # model za kadar koji se broji (yolov10m/s/n su brži, manje tačni)
# KAMERE_MODEL_BRZI=yolov10m    # model za praćenje kroz kadrove
# KAMERE_SAMO=                  # samo ove kamere, npr. horgos-ulaz,horgos-izlaz
# KAMERE_PROZOR=30              # sekundi gledanja po kameri
# KAMERE_PROZOR_KOLONA=90       # sekundi gledanja kad je bilo kolone
# KAMERE_PRAG=0.18              # najmanja pouzdanost detekcije
